---
import '../styles/global.css';
import '../styles/app.css';
import { sitio } from '../config/sitio';
import Logo from '../components/Logo.astro';

interface Props {
  titulo: string;
  descripcion: string;
  sinNav?: boolean;
}

const { titulo, descripcion, sinNav = false } = Astro.props;
const tituloCompleto = `${titulo} | ${sitio.nombre}`;
---

<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descripcion} />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#FAF7F0" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@800&family=Source+Sans+3:wght@400;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class:list={['app-cuerpo', sinNav && 'app-sin-nav']}>
    <a class="saltar" href="#contenido">Saltar al contenido</a>
    <header class="app-cabecera">
      <div class="columna app-cabecera-interior">
        <a class="logo-enlace" href="/app" aria-label={sitio.nombre}>
          <Logo />
        </a>
        <nav class="app-nav" aria-label="App">
          <a href="/app">Bloques</a>
          <a href="/app/sesion">Hoy</a>
          <a href="/app/historial">Historial</a>
          <a href="/app/avance">Avance</a>
        </nav>
        <a class="app-salir" href="/app/entrar?salir=1">Salir</a>
      </div>
      <div class="franja" aria-hidden="true"></div>
    </header>
    <main id="contenido" class="app-main">
      <div class="columna" id="app-raiz">
        <slot />
      </div>
    </main>
  </body>
</html>
