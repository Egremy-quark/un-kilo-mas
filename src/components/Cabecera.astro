---
import { sitio } from '../config/sitio';
import Logo from './Logo.astro';

const ruta = Astro.url.pathname.replace(/\/$/, '') || '/';
const enInicio = ruta === '/';
const enCoaching = ruta === '/coaching';
const a = (ancla: string) => (enInicio ? ancla : `/${ancla}`);
---

<header class="cabecera">
  <div class="columna cabecera-interior">
    <a class="logo-enlace" href="/" aria-label={sitio.nombre}>
      <Logo />
    </a>
    <nav class="cabecera-nav" aria-label="Secciones">
      <a href={a('#casos')}>Casos reales</a>
      <a href={a('#rutina')}>Empieza gratis</a>
      <a href={a('#calculadoras')}>Calculadoras</a>
      <a href="/coaching" aria-current={enCoaching ? 'page' : undefined}>Coaching</a>
    </nav>
    <a class="boton boton-compacto" href={a('#rutina')}>Empieza gratis</a>
  </div>
  <div class="franja" aria-hidden="true"></div>
</header>
