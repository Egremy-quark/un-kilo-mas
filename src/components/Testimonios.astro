---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { testimoniosAutorizados, type Testimonio } from '../config/sitio';

interface Props {
  limite?: number;
}

const { limite } = Astro.props;
const archivos = import.meta.glob<{ default: ImageMetadata }>('../assets/testimonios/*.{jpg,jpeg,png,webp}', {
  eager: true,
});

function fotoDe(nombre: string): ImageMetadata | undefined {
  const entrada = Object.entries(archivos).find(([ruta]) => ruta.endsWith(`/${nombre}`));
  return entrada?.[1].default;
}

const lista = testimoniosAutorizados().slice(0, limite);

function altDe(item: Testimonio): string {
  return `${item.nombre} antes y después de entrenar con Yohan`;
}

const nombresRestantes = lista
  .slice(1)
  .map((item) => item.nombre)
  .join(', ')
  .replace(/, ([^,]*)$/, ' y $1');
---

{
  lista.length > 0 && (
    <section class="banda banda-blanco" id="casos" data-carrusel-raiz aria-labelledby="casos-titulo">
      <div class="columna">
        <h2 id="casos-titulo">
          Gente ocupada, <em>años de constancia</em>
        </h2>
        <div class="carrusel-pista testimonios-pista">
          {lista.map((item, indice) => {
            const foto = fotoDe(item.foto);
            return (
              <article class:list={['card', 'carrusel-tarjeta', 'testimonio-tarjeta', { 'es-activa': indice === 0 }]}>
                <div class="testimonio-foto">
                  {foto ? (
                    <Image
                      src={foto}
                      alt={altDe(item)}
                      width={800}
                      height={500}
                      format="webp"
                      loading="lazy"
                    />
                  ) : (
                    <p>{altDe(item)}</p>
                  )}
                </div>
                <div class="testimonio-cuerpo">
                  <p class="testimonio-nombre">{item.nombre}</p>
                  <p class="testimonio-texto">
                    <b>{item.perfil}.</b> {item.texto}
                  </p>
                  <p class="testimonio-tiempo">{item.tiempo}</p>
                </div>
              </article>
            );
          })}
        </div>
        {lista.length > 1 && (
          <div class="carrusel-controles">
            <div class="carrusel-puntos">
              {lista.map((item, indice) => (
                <button
                  type="button"
                  class="carrusel-punto"
                  data-indice={indice}
                  aria-label={`${item.nombre}, ${indice + 1} de ${lista.length}`}
                  aria-current={indice === 0 ? 'true' : undefined}
                />
              ))}
            </div>
          </div>
        )}
        <p class="testimonios-aviso testimonios-aviso-movil">
          {nombresRestantes ? `Desliza para ver a ${nombresRestantes}. ` : ''}
          Clientes reales del coaching personal de Yohan, después de años de constancia. Cada cuerpo
          avanza a su ritmo; esto no es una promesa de resultados.
        </p>
        <p class="testimonios-aviso testimonios-aviso-escritorio">
          Clientes reales del coaching personal de Yohan, después de años de constancia. Cada cuerpo
          avanza a su ritmo; esto no es una promesa de resultados. Se publican solo con su
          autorización.
        </p>
      </div>
    </section>
  )
}

{
  lista.length > 1 && (
    <script>
      import { iniciarCarrusel } from '../scripts/carrusel';
      const raiz = document.querySelector<HTMLElement>('[data-carrusel-raiz]');
      if (raiz) iniciarCarrusel(raiz);
    </script>
  )
}
