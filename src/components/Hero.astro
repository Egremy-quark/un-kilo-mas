---
import { sitio } from '../config/sitio';
import { TRAZO_MAS, TRAZO_UNO, urlInstagram } from '../lib/marca';

/**
 * El nombre del certificado sigue [POR DEFINIR] en sitio.ts.
 * Este sello no lo muestra: solo «entrenador certificado» y «carrera de nutrición».
 */
const instagram = urlInstagram(sitio.yohan.instagram);
---

<section class="hero" aria-labelledby="hero-titulo">
  <div class="hero-marca">
    <svg class="hero-mas" viewBox="0 0 100 100" role="img" aria-label="Más uno">
      <circle cx="50" cy="50" r="50" fill="var(--lima)" />
      <path d={TRAZO_MAS} fill="var(--tinta)" />
      <path d={TRAZO_UNO} fill="var(--tinta)" />
    </svg>
    <svg class="hero-ciclo" viewBox="0 0 168 96" role="img" aria-label="Mesociclo: las semanas suben y una semana es más suave">
      <rect x="4" y="62" width="18" height="26" fill="var(--tinta)" />
      <rect x="30" y="48" width="18" height="40" fill="var(--tinta)" />
      <rect x="56" y="34" width="18" height="54" fill="var(--tinta)" />
      <rect x="82" y="20" width="18" height="68" fill="var(--tinta)" />
      <rect x="108" y="46" width="18" height="42" fill="#fff" stroke="var(--tinta)" stroke-width="2" />
      <rect x="134" y="8" width="18" height="80" fill="var(--tinta)" />
      <polyline
        points="13,60 39,46 65,32 91,18 117,44 143,6"
        fill="none"
        stroke="var(--lima)"
        stroke-width="3"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    </svg>
  </div>
  <h1 id="hero-titulo">Avanza <em>más</em></h1>
  <p class="hero-frase">Tu 1RM, tu proteína y tus calorías.</p>
  <div class="hero-acciones">
    <a class="boton" href="#que-hacer">¿Qué quieres hacer?</a>
    <a class="hero-enlace" href="/coaching">Entrena con Yohan</a>
  </div>
  <div class="hero-notas">
    <p>Gratis y sin registrarte</p>
    <p>
      Yohan, <a href={instagram} rel="noopener noreferrer">@{sitio.yohan.instagram}</a>. Entrenador
      certificado, carrera de nutrición.
    </p>
  </div>
</section>
