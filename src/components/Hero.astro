---
import { Image } from 'astro:assets';
import { sitio } from '../config/sitio';
import { urlInstagram } from '../lib/marca';
import yohanHoy from '../assets/testimonios/yohan-hoy.jpg';

const instagram = urlInstagram(sitio.yohan.instagram);
---

<section class="hero" aria-labelledby="hero-titulo">
  <div class="columna hero-interior">
    <div class="hero-texto">
      <h1 id="hero-titulo">Llega al gym <em>sabiendo qué hacer</em></h1>
      <p class="hero-frase">
        Empieza gratis en tu casa, a tu ritmo y sin que nadie te vea. Después, en el gym, con un plan.
      </p>
      <div class="hero-acciones">
        <a class="boton" href="#rutina">Quiero la Rutina 01 gratis</a>
        <a class="hero-enlace" href="#coaching">Entrena con Yohan</a>
      </div>
    </div>
    <aside class="hero-sello" aria-label="Credenciales de Yohan">
      <Image
        src={yohanHoy}
        alt="Yohan, entrenador"
        width={640}
        height={800}
        format="webp"
        loading="eager"
      />
      <p>
        <b>Con Yohan, entrenador certificado</b>
        <span>Carrera de nutrición · <a href={instagram} rel="noopener noreferrer">@{sitio.yohan.instagram}</a></span>
      </p>
    </aside>
  </div>
</section>
