<section class="guia" aria-label="Cómo usar las calculadoras">
  <ol class="guia-pasos">
    <li class="guia-paso">
      <span class="paso-num">1</span>
      <svg class="paso-dibujo" viewBox="0 0 280 150" role="img" aria-label="Tres pestañas: 1RM, proteína y calorías. La primera está elegida.">
        <rect x="8" y="18" width="84" height="40" fill="var(--tinta)" />
        <rect x="100" y="18" width="84" height="40" fill="none" stroke="var(--tinta)" stroke-width="2.5" />
        <rect x="192" y="18" width="80" height="40" fill="none" stroke="var(--tinta)" stroke-width="2.5" />
        <rect x="8" y="58" width="84" height="5" fill="var(--lima)" />
        <text x="50" y="44" text-anchor="middle" fill="var(--hueso)" font-family="Barlow Condensed, sans-serif" font-size="18" font-weight="800">1RM</text>
        <text x="142" y="44" text-anchor="middle" fill="var(--tinta)" font-family="Barlow Condensed, sans-serif" font-size="16" font-weight="800">PROTEÍNA</text>
        <text x="232" y="44" text-anchor="middle" fill="var(--tinta)" font-family="Barlow Condensed, sans-serif" font-size="15" font-weight="800">CALORÍAS</text>
        <rect x="8" y="76" width="264" height="58" fill="none" stroke="var(--tinta)" stroke-width="2.5" />
      </svg>
      <h2 class="paso-titulo">Elige qué calcular</h2>
    </li>
    <li class="guia-paso">
      <span class="paso-num">2</span>
      <svg class="paso-dibujo" viewBox="0 0 280 160" role="img" aria-label="Formulario con dos campos y el botón Calcular.">
        <rect x="16" y="16" width="248" height="36" rx="10" fill="var(--hueso)" stroke="var(--tinta)" stroke-width="2.5" />
        <rect x="16" y="64" width="248" height="36" rx="10" fill="var(--hueso)" stroke="var(--tinta)" stroke-width="2.5" />
        <rect x="16" y="114" width="148" height="34" rx="12" fill="var(--lima)" />
        <text x="90" y="137" text-anchor="middle" fill="var(--tinta)" font-family="Source Sans 3, sans-serif" font-size="16" font-weight="700">Calcular</text>
      </svg>
      <h2 class="paso-titulo">Mete tus datos</h2>
    </li>
    <li class="guia-paso">
      <span class="paso-num">3</span>
      <svg class="paso-dibujo" viewBox="0 0 280 148" role="img" aria-label="Ejemplo de formato: un número grande, su unidad y una flecha más uno.">
        <text x="8" y="96" fill="var(--tinta)" font-family="Barlow Condensed, sans-serif" font-size="76" font-weight="800">115</text>
        <text x="128" y="96" fill="var(--tinta)" font-family="Source Sans 3, sans-serif" font-size="26" font-weight="700">kg</text>
        <path d="M176 78 H204" fill="none" stroke="var(--lima)" stroke-width="3" stroke-linecap="round" />
        <path d="M192 66 L208 78 L192 90" fill="none" stroke="var(--lima)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
        <circle cx="244" cy="78" r="26" fill="var(--lima)" />
        <g transform="translate(226 60) scale(0.36)">
          <path d="M17 45h34v10H17zM29 32h10v36H29z" fill="var(--tinta)" />
          <path d="M69 28h14v48H69zM57 42 69 28v14z" fill="var(--tinta)" />
        </g>
      </svg>
      <h2 class="paso-titulo">Entrena con tu número</h2>
    </li>
  </ol>
</section>
