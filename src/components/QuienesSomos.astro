---
import GraficaMesociclo from './GraficaMesociclo.astro';

/**
 * Explicación corta de la marca. La suscripción y la app se nombran solo como etapas posteriores.
 * No tienen precio, fecha ni botón.
 */
---

<section class="quienes" aria-labelledby="quienes-titulo">
  <div class="columna">
    <h2 id="quienes-titulo">Quiénes <em>somos</em></h2>
    <p class="quienes-frase">Somos un ecosistema que crece con el cliente.</p>

    <div class="quienes-ideas">
      <article>
        <h3>Qué somos</h3>
        <p>Programas, mesociclos, nutrición y coaching, en números. Después, suscripción y app.</p>
      </article>
      <article>
        <h3>Por qué crecemos con el cliente</h3>
        <p>Primero un número, luego un plan, después seguimiento. Si no, se va al avanzar.</p>
      </article>
      <article>
        <h3>Para qué sirve</h3>
        <p>Entra gratis, avanza +1 y, si necesita más, sigue aquí con el mismo coach.</p>
      </article>
    </div>

    <p class="quienes-sello">
      Yohan es entrenador certificado, con carrera de nutrición, y competidor de powerlifting y de
      culturismo natural.
    </p>
    <p class="quienes-historia">
      Empezó a los 15 años, aprendiendo solo, y lleva más de 10 años sacando gente desde cero.
      <a href="/coaching#historia">Leer su historia</a>
    </p>

    <div class="camino" aria-label="Cómo crece Un Kilo Más">
      <GraficaMesociclo etiqueta="El camino sube de a poco: calcular, entrenar y, más adelante, suscripción y app." />
      <ol>
        <li>
          <p class="camino-cuando">Hoy</p>
          <h3>Calcula gratis</h3>
          <p>1RM, proteína y calorías.</p>
        </li>
        <li>
          <p class="camino-cuando">Hoy</p>
          <h3>Entrena con Yohan</h3>
          <p>Coaching.</p>
        </li>
        <li class="camino-luego">
          <p class="camino-cuando">Después</p>
          <h3>Suscripción</h3>
          <p>Próximamente.</p>
        </li>
        <li class="camino-luego">
          <p class="camino-cuando">Al final</p>
          <h3>App</h3>
          <p>Próximamente.</p>
        </li>
      </ol>
    </div>

    <p class="quienes-cierre">
      <a class="hero-enlace" href="/coaching">Entrena con Yohan</a>
    </p>
  </div>
</section>
